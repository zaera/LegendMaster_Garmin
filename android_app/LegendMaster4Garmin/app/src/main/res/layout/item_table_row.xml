<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="2dp">

    <TextView android:id="@+id/cellA" android:layout_width="40dp" android:layout_height="50dp" android:gravity="center" android:background="@drawable/cell_border" android:textColor="#888888" />
    <TextView android:id="@+id/cellB" android:layout_width="45dp" android:layout_height="50dp" android:gravity="center" android:textStyle="bold" android:background="@drawable/cell_border" android:textColor="#FFFFFF" />

    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellC" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtC" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#55AAFF" />

    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellD" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtD" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellE" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtE" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellF" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtF" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#55AAFF" />

    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellG" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtG" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_margin="1dp" android:background="@drawable/cell_border">
        <ImageView android:id="@+id/cellH" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:scaleType="fitCenter" />
        <TextView android:id="@+id/txtH" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="#FFFFFF" android:background="#000000" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>

    <Button android:id="@+id/btnUp" android:layout_width="40dp" android:layout_height="40dp" android:text="^" android:layout_marginStart="4dp"/>
    <Button android:id="@+id/btnDown" android:layout_width="40dp" android:layout_height="40dp" android:text="v" />
    <Button android:id="@+id/btnDelRow" android:layout_width="40dp" android:layout_height="40dp" android:text="X" android:backgroundTint="#FF4444" />
</LinearLayout>