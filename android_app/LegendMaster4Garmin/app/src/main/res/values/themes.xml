<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LegendMaster4Garmin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#55AAFF</item>
        <item name="colorPrimaryVariant">#0080FF</item>
        <item name="colorOnPrimary">#000000</item>

        <item name="android:windowBackground">#141414</item> <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#AAAAAA</item>

        <item name="android:dialogTheme">@style/CustomDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CustomDialogTheme</item>
        
        <item name="colorControlNormal">#55AAFF</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:background">#1A1A1A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#55AAFF</item>
        <item name="colorAccent">#55AAFF</item>
        
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#55AAFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TableAlertDialogStyle" parent="CustomDialogTheme" />

    <style name="HeaderCell">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DataCell">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/cell_border</item>
    </style>
</resources>